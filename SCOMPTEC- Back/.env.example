# Banco de dados do backend. Ajuste usuário, senha, servidor e nome do banco.
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/cnc_monitor?charset=utf8mb4
SQL_ECHO=false
DEVICE_OFFLINE_TIMEOUT_SECONDS=90
# Compartilhada entre backend e Opta (header X-Device-Key); nunca colocar no frontend.
# Vazia permite integração inicial em rede local isolada.
DEVICE_API_KEY=

# Endereços do FRONTEND, separados por vírgula, sem barra final e sem /api.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Defina uma chave aleatória privada em cada instalação.
AUTH_SECRET=troque-esta-chave-em-producao
AUTH_TOKEN_TTL_MINUTES=480

# Conta administrativa sincronizada ao iniciar o backend. Preencha os dois campos.
# Use uma senha de 8 a 128 caracteres. Nunca coloque estas variáveis no frontend.
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=
